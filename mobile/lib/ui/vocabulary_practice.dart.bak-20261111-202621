import 'dart:async';
import 'dart:math';

import 'package:flutter/material.dart';
import 'package:flutter_tts/flutter_tts.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

import 'components.dart';

class LiveVocabularyPractice extends StatefulWidget {
  const LiveVocabularyPractice({super.key, required this.courseId, required this.canTrack});
  final String courseId;
  final bool canTrack;

  @override
  State<LiveVocabularyPractice> createState() => _LiveVocabularyPracticeState();
}

class _LiveVocabularyPracticeState extends State<LiveVocabularyPractice> {
  final _tts = FlutterTts();
  late Future<_PracticeData> _data;
  int _index = 0;
  bool _showMeaning = false;
  bool _saving = false;
  final List<Offset> _stroke = [];

  @override
  void initState() {
    super.initState();
    unawaited(_configureTts());
    _load();
  }

  Future<void> _configureTts() async {
    await _tts.setLanguage('zh-CN');
    await _tts.setSpeechRate(0.42);
  }

  void _load() {
    _data = _fetch();
  }

  Future<_PracticeData> _fetch() async {
    final client = Supabase.instance.client;
    final words = await client
        .from('learning_vocabulary')
        .select('id,hanzi,pinyin,meaning_ar,meaning_en,example_zh,example_ar,hsk_level,position')
        .eq('course_id', widget.courseId)
        .eq('is_published', true)
        .order('position');
    String? studentId;
    final user = client.auth.currentUser;
    if (widget.canTrack && user != null) {
      final student = await client.from('students').select('id').eq('user_id', user.id).maybeSingle();
      studentId = student?['id'] as String?;
    }
    return _PracticeData(List<Map<String, dynamic>>.from(words), studentId);
  }

  Future<void> _saveProgress(_PracticeData data, Map<String, dynamic> word, bool known) async {
    final sid = data.studentId;
    if (sid == null) return;
    setState(() => _saving = true);
    try {
      final client = Supabase.instance.client;
      final existing = await client
          .from('learning_vocab_progress')
          .select('review_count')
          .eq('vocabulary_id', word['id'])
          .eq('student_id', sid)
          .maybeSingle();
      await client.from('learning_vocab_progress').upsert({
        'vocabulary_id': word['id'],
        'student_id': sid,
        'status': known ? 'known' : 'learning',
        'review_count': ((existing?['review_count'] as num?)?.toInt() ?? 0) + 1,
        'last_reviewed_at': DateTime.now().toUtc().toIso8601String(),
        'updated_at': DateTime.now().toUtc().toIso8601String(),
      }, onConflict: 'vocabulary_id,student_id');
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(known ? 'أُضيفت إلى الكلمات المتقنة' : 'سُجلت للمراجعة')));
      }
    } catch (_) {
      if (mounted) ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('تعذر حفظ تقدمك. تحقق من ربط الطالب وسياسة صلاحيات التقدم.')));
    } finally {
      if (mounted) setState(() => _saving = false);
    }
  }

  void _next(int length) {
    setState(() {
      _index = (_index + 1) % length;
      _showMeaning = false;
      _stroke.clear();
    });
  }

  Future<void> _quiz(_PracticeData data, Map<String, dynamic> word) async {
    final correct = '${word['meaning_ar'] ?? word['meaning_en'] ?? ''}';
    final alternatives = data.words
        .where((item) => item['id'] != word['id'])
        .map((item) => '${item['meaning_ar'] ?? item['meaning_en'] ?? ''}')
        .where((value) => value.isNotEmpty && value != correct)
        .toSet()
        .toList()
      ..shuffle(Random());
    final choices = ([correct, ...alternatives.take(3)]..shuffle(Random()));
    if (!mounted) return;
    await showDialog<void>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        backgroundColor: darkRed,
        title: Text('ما معنى ${word['hanzi']}؟', textAlign: TextAlign.center),
        content: Column(mainAxisSize: MainAxisSize.min, children: [
          for (final choice in choices)
            Padding(
              padding: const EdgeInsets.only(bottom: 8),
              child: SizedBox(width: double.infinity, child: OutlinedButton(
                onPressed: () {
                  Navigator.pop(dialogContext);
                  ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(choice == correct ? 'إجابة صحيحة، أحسنت!' : 'الإجابة الصحيحة: $correct')));
                },
                child: Text(choice),
              )),
            ),
        ]),
      ),
    );
  }

  @override
  void dispose() {
    unawaited(_tts.stop());
    super.dispose();
  }

  @override
  Widget build(BuildContext context) => FutureBuilder<_PracticeData>(
    future: _data,
    builder: (context, snapshot) {
      if (snapshot.connectionState != ConnectionState.done) return const Center(child: CircularProgressIndicator());
      if (snapshot.hasError) return EmptyPanel('تعذر تحميل المفردات المنشورة لهذا المقرر.');
      final data = snapshot.data!;
      if (data.words.isEmpty) return EmptyPanel('لا توجد مفردات منشورة لهذا المقرر بعد. أضف المفردات من إدارة المحتوى.');
      final word = data.words[_index % data.words.length];
      final hanzi = '${word['hanzi'] ?? ''}';
      final image = hanzi == '门' ? 'assets/images/vocab_door.png' : hanzi == '猪' ? 'assets/images/vocab_pig.png' : null;
      return ListView(
        padding: const EdgeInsets.all(14),
        children: [
          Row(children: [const Expanded(child: SectionHeading('تدريب المفردات الصينية')), Text('${_index + 1}/${data.words.length}')]),
          SaiCard(child: Column(children: [
            if (image != null) ClipRRect(borderRadius: BorderRadius.circular(14), child: Image.asset(image, height: 190, width: double.infinity, fit: BoxFit.cover)),
            const SizedBox(height: 12),
            Text(hanzi, textDirection: TextDirection.ltr, style: const TextStyle(fontFamily: 'NotoSC', fontSize: 64, fontWeight: FontWeight.bold, color: ink)),
            Text('${word['pinyin'] ?? ''}', textDirection: TextDirection.ltr, style: const TextStyle(fontSize: 20, color: gold)),
            const SizedBox(height: 8),
            if (_showMeaning) Text('${word['meaning_ar'] ?? word['meaning_en'] ?? ''}', textAlign: TextAlign.center, style: const TextStyle(fontSize: 19)),
            Wrap(alignment: WrapAlignment.center, spacing: 8, children: [
              OutlinedButton.icon(onPressed: () => _tts.speak(hanzi), icon: const Icon(Icons.volume_up), label: const Text('استمع')),
              OutlinedButton.icon(onPressed: () => setState(() => _showMeaning = !_showMeaning), icon: const Icon(Icons.visibility), label: Text(_showMeaning ? 'إخفاء المعنى' : 'أظهر المعنى')),
            ]),
            if ('${word['example_zh'] ?? ''}'.isNotEmpty) Text('${word['example_zh']}', textDirection: TextDirection.ltr, style: const TextStyle(fontFamily: 'NotoSC', fontSize: 20)),
            if ('${word['example_ar'] ?? ''}'.isNotEmpty) Text('${word['example_ar']}', textAlign: TextAlign.center),
          ])),
          const SectionHeading('تدرّب على كتابة الحرف'),
          SaiCard(child: Column(children: [
            Container(height: 150, width: double.infinity, decoration: BoxDecoration(color: const Color(0xFF740009), borderRadius: BorderRadius.circular(12), border: Border.all(color: gold)),
              child: GestureDetector(onPanUpdate: (d) => setState(() => _stroke.add(d.localPosition)), onPanEnd: (_) => setState(() => _stroke.add(Offset.infinite)), child: CustomPaint(painter: _StrokePainter(List<Offset>.of(_stroke)), child: Center(child: Opacity(opacity: .20, child: Text(hanzi, style: const TextStyle(fontFamily: 'NotoSC', fontSize: 92, color: ink))))),
            ),
            TextButton.icon(onPressed: () => setState(_stroke.clear), icon: const Icon(Icons.refresh), label: const Text('مسح وإعادة الكتابة')),
          ])),
          const SectionHeading('استرجاع نشط'),
          SaiCard(child: Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
            const Text('ما معنى هذه الكلمة؟ حاول تذكرها قبل إظهار الإجابة.'),
            const SizedBox(height: 8),
            Wrap(alignment: WrapAlignment.center, spacing: 8, children: [
              OutlinedButton(onPressed: _saving ? null : () => _saveProgress(data, word, false), child: const Text('أحتاج مراجعة')),
              FilledButton(onPressed: _saving ? null : () => _saveProgress(data, word, true), child: const Text('أتقنتها')),
              OutlinedButton.icon(onPressed: () => _quiz(data, word), icon: const Icon(Icons.quiz_outlined), label: const Text('اختبر ذاكرتك')),
              TextButton(onPressed: () => _next(data.words.length), child: const Text('الكلمة التالية')),
            ]),
          ])),
          if (data.studentId == null) const Text('سجل تقدم المراجعة يتطلب ربط حساب الطالب بسجل طالب في قاعدة البيانات.', textAlign: TextAlign.center),
        ],
      );
    },
  );
}

class _PracticeData {
  const _PracticeData(this.words, this.studentId);
  final List<Map<String, dynamic>> words;
  final String? studentId;
}

class _StrokePainter extends CustomPainter {
  const _StrokePainter(this.points);
  final List<Offset> points;
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()..color = gold..strokeWidth = 5..strokeCap = StrokeCap.round;
    for (var i = 1; i < points.length; i++) {
      if (points[i - 1] != Offset.infinite && points[i] != Offset.infinite) canvas.drawLine(points[i - 1], points[i], paint);
    }
  }
  @override
  bool shouldRepaint(covariant _StrokePainter oldDelegate) => true;
}
